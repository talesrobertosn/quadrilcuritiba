{
  "name": "quadrilcuritiba",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Gerador estático em TypeScript do site quadrilcuritiba.com.br",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "qa": "tsx scripts/qa.ts",
    "serve": "tsx scripts/serve.ts",
    "shots": "tsx scripts/shots.ts",
    "uitest": "tsx scripts/uitest.ts",
